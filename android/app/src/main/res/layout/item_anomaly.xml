<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="?attr/selectableItemBackground">

    <!-- Severity Indicator Bar -->
    <View
        android:id="@+id/severity_indicator"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="8dp"
        android:background="@color/severity_medium" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Type and Confidence Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/anomaly_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/anomaly_confidence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bahb_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/anomaly_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />

        <!-- Timestamp -->
        <TextView
            android:id="@+id/anomaly_timestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>
