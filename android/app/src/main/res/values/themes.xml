<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base BAHB Theme - Dark for outdoor visibility -->
    <style name="Theme.BAHB" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/bahb_primary</item>
        <item name="colorPrimaryDark">@color/bahb_primary_dark</item>
        <item name="colorAccent">@color/bahb_accent</item>
        <item name="android:windowBackground">@color/bahb_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Fullscreen Theme for FPV View -->
    <style name="Theme.BAHB.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
