# Dockerfile for BAHB Training on NVIDIA DGX Spark (GB10 Superchip)
# Training-focused: no drone/camera/streaming dependencies
#
# Build:
#   docker compose -f deployment/docker-compose.dgx-spark.yml build
#
# Run training:
#   docker compose -f deployment/docker-compose.dgx-spark.yml run --rm bahb-training \
#     python3 train_yolo26.py --model x --epochs 200 --batch 64 --imgsz 1280

# =============================================================================
# Stage 1: Base Image — NGC PyTorch with CUDA 12.8+ and Blackwell support
# =============================================================================
FROM nvcr.io/nvidia/pytorch:25.03-py3 AS base

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:${PATH}

# System packages for OpenCV and general build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    wget \
    curl \
    ca-certificates \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Stage 2: Python Dependencies (training-only subset)
# =============================================================================
FROM base AS dependencies

WORKDIR /workspace

# Install training-relevant Python packages
# Skip: DJI SDK, streaming, thermal, 3D mapping, MQTT, Redis, gRPC
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    # Core ML frameworks (torch/torchvision already in NGC base)
    pip install --no-cache-dir \
        ultralytics>=8.1.0 \
        transformers>=4.38.0 \
        accelerate>=0.27.0 \
        safetensors>=0.4.0 \
        timm>=0.9.0 && \
    # Computer vision
    pip install --no-cache-dir \
        opencv-python-headless>=4.9.0 \
        Pillow>=10.2.0 \
        scikit-image>=0.22.0 \
        albumentations>=1.3.0 && \
    # Data processing
    pip install --no-cache-dir \
        numpy>=1.26.0 \
        pandas>=2.2.0 \
        scipy>=1.12.0 && \
    # Configuration and logging
    pip install --no-cache-dir \
        pyyaml>=6.0.0 \
        pydantic>=2.6.0 \
        pydantic-settings>=2.2.0 \
        loguru>=0.7.0 \
        click>=8.1.0 \
        tqdm>=4.66.0 \
        python-dotenv>=1.0.0 \
        rich>=13.7.0 && \
    # Evaluation and monitoring
    pip install --no-cache-dir \
        pycocotools>=2.0.0 \
        tensorboard>=2.16.0 \
        matplotlib>=3.8.0 && \
    # Serialization
    pip install --no-cache-dir \
        msgpack>=1.0.0 \
        orjson>=3.9.0 && \
    # Monitoring endpoint
    pip install --no-cache-dir \
        prometheus-client>=0.20.0 \
        aiohttp>=3.9.0 && \
    rm -rf ~/.cache/pip

# =============================================================================
# Stage 3: Application Code
# =============================================================================
FROM dependencies AS application

WORKDIR /workspace

# Copy application code
COPY bahb/ /workspace/bahb/
COPY configs/ /workspace/configs/
COPY scripts/ /workspace/scripts/
COPY train_bahb.py train_yolo26.py train_rf_detr_seg.py \
     train_adversarial_manifold3.py train_merged_dataset.py \
     run_training.py /workspace/
COPY pyproject.toml /workspace/

# Install BAHB package
RUN pip install --no-cache-dir -e .

# Create workspace directories
RUN mkdir -p \
    /workspace/data \
    /workspace/runs \
    /workspace/models \
    /workspace/logs

# =============================================================================
# Stage 4: Runtime
# =============================================================================
FROM application AS runtime

LABEL maintainer="BAHB Team" \
      version="1.0.0" \
      description="BAHB Training Environment for DGX Spark (GB10 Blackwell)" \
      platform="dgx-spark"

# Runtime environment
ENV BAHB_PROJECT_ROOT=/workspace \
    BAHB_DATA_DIR=/workspace/data \
    BAHB_MODELS_DIR=/workspace/models \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility \
    CUDA_DEVICE_ORDER=PCI_BUS_ID \
    PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Entrypoint script
RUN cat > /workspace/entrypoint.sh << 'ENTRYPOINT_EOF'
#!/bin/bash
set -e

echo "============================================================"
echo "BAHB Training Environment — DGX Spark (GB10 Blackwell)"
echo "============================================================"
echo ""

# GPU info
echo "GPU Status:"
nvidia-smi --query-gpu=name,memory.total,driver_version,compute_cap \
    --format=csv,noheader 2>/dev/null || echo "  nvidia-smi not available"
echo ""

# CUDA verification
python3 -c "
import torch
print(f'PyTorch:  {torch.__version__}')
print(f'CUDA:     {torch.version.cuda}')
print(f'cuDNN:    {torch.backends.cudnn.version()}')
if torch.cuda.is_available():
    print(f'GPU:      {torch.cuda.get_device_name(0)}')
    mem = torch.cuda.get_device_properties(0).total_mem / (1024**3)
    print(f'Memory:   {mem:.1f} GB')
    print(f'Arch:     sm_{torch.cuda.get_device_capability(0)[0]}{torch.cuda.get_device_capability(0)[1]}')
else:
    print('WARNING: CUDA not available!')
" 2>/dev/null || echo "WARNING: PyTorch CUDA check failed"

echo ""
echo "Workspace: /workspace"
echo "Data:      /workspace/data"
echo "Runs:      /workspace/runs"
echo "============================================================"
echo ""

cd /workspace

if [ $# -eq 0 ]; then
    exec bash
else
    exec "$@"
fi
ENTRYPOINT_EOF
chmod +x /workspace/entrypoint.sh

# Health check script
RUN cat > /usr/local/bin/healthcheck.sh << 'HEALTH_EOF'
#!/bin/bash
python3 -c "
import socket, sys
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(2)
result = s.connect_ex(('localhost', 8081))
s.close()
sys.exit(result)
"
HEALTH_EOF
chmod +x /usr/local/bin/healthcheck.sh

WORKDIR /workspace

# Expose ports
EXPOSE 6006/tcp    # TensorBoard
EXPOSE 8081/tcp    # Health check

HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD /usr/local/bin/healthcheck.sh || exit 1

ENTRYPOINT ["/workspace/entrypoint.sh"]
CMD []
