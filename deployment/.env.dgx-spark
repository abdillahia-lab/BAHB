# BAHB DGX Spark Training Environment
# Target: DGX Spark (GB10 Blackwell), hostname: jinki

# ===========================================
# Host Paths (on DGX Spark)
# ===========================================
DATA_DIR=/data/bahb

# ===========================================
# GPU Configuration
# ===========================================
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
CUDA_DEVICE_ORDER=PCI_BUS_ID

# ===========================================
# Memory Optimization (128GB unified memory)
# ===========================================
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# ===========================================
# Training Defaults
# ===========================================
BAHB_PROJECT_ROOT=/workspace
BAHB_DATA_DIR=/workspace/data
BAHB_MODELS_DIR=/workspace/models

# ===========================================
# Logging
# ===========================================
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1
