# BAHB Environment Variables
# Copy this file to .env and update with your values

# ==========================================
# Aircraft Configuration
# ==========================================
AIRCRAFT_SERIAL=M400-XXXXX

# ==========================================
# Alerts Configuration
# ==========================================
# MQTT Broker (default: localhost for local broker)
MQTT_BROKER=localhost:1883
MQTT_USERNAME=bahb_user
MQTT_PASSWORD=change_me_in_production

# Webhook for external alerts
WEBHOOK_URL=https://your-webhook-url.com/bahb/alerts

# ==========================================
# Monitoring Configuration (Optional)
# ==========================================
# Grafana admin password
GRAFANA_PASSWORD=secure_password_here

# ==========================================
# BAHB Configuration
# ==========================================
# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Data directory
BAHB_DATA_DIR=/data/bahb

# Model directory
BAHB_MODELS_DIR=/opt/bahb/deployment/models

# ==========================================
# Camera Configuration (DJI H30T)
# ==========================================
# RTSP stream URLs (update IP if different)
RTSP_WIDE=rtsp://192.168.42.2:8554/wide
RTSP_ZOOM=rtsp://192.168.42.2:8554/zoom
RTSP_THERMAL=rtsp://192.168.42.2:8554/thermal

# ==========================================
# Network Configuration
# ==========================================
# WebRTC STUN servers
STUN_SERVER=stun:stun.l.google.com:19302

# Optional: RTMP streaming
RTMP_ENABLED=false
RTMP_URL=rtmp://your-streaming-server.com/live/stream_key

# ==========================================
# Performance Tuning
# ==========================================
# GPU memory fraction (0.0 to 1.0)
GPU_MEMORY_FRACTION=0.9

# Number of inference workers
MAX_WORKERS=8

# Enable TensorRT optimizations
TENSORRT_ENABLED=true
TENSORRT_PRECISION=fp16

# ==========================================
# Feature Flags
# ==========================================
# Enable experimental features
ENABLE_VLM=true
ENABLE_3D_MAPPING=false
ENABLE_THERMAL_ANALYSIS=true

# ==========================================
# Optional: Cloud Integration
# ==========================================
# AWS S3 for report upload
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=

# ==========================================
# Optional: Database
# ==========================================
# PostgreSQL connection (for advanced deployments)
DATABASE_URL=postgresql://user:password@localhost:5432/bahb

# Redis cache
REDIS_URL=redis://localhost:6379/0

# ==========================================
# Safety and Limits
# ==========================================
# Maximum flight altitude (meters)
MAX_ALTITUDE=120

# Maximum horizontal speed during inspection (m/s)
MAX_SPEED=15

# Geofence radius (meters)
GEOFENCE_RADIUS=500

# Battery warning threshold (%)
BATTERY_WARNING=30
BATTERY_CRITICAL=20
BATTERY_RTL=15
